    {
      "cell_type": "code",
      "source": [
        "# 2. Nettoyage des colonnes de type \"Texte\" qui devraient être des nombres dans df_games\n",
        "# faire une Liste des colonnes à convertir\n",
        "colonnes_nombres = ['ratings', 'metacritic', 'playtime', 'achievement_count', 'ratings_count']\n",
        "\n",
        "for col in colonnes_nombres:\n",
        "    if col in df_games.columns:\n",
        "        # errors='coerce' transforme les textes en NaN (vide)\n",
        "        df_games[col] = pd.to_numeric(df_games[col], errors='coerce')\n",
        "\n",
        "print(\"Nettoyage des nombres terminé !\")"
      ],
      "metadata": {
        "id": "145uI4VwfC5_",
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "outputId": "99e2ae34-5a1e-498d-fa21-a82ef64215fd"
      },
      "execution_count": null,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Nettoyage des nombres terminé !\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "# 3. Uniformiser les noms des consoles\n",
        "dictionnaire_consoles = {\n",
        "    'PlayStation 4': 'PS4',\n",
        "    'PlayStation 3': 'PS3',\n",
        "    'PlayStation 2': 'PS2',\n",
        "    'PlayStation': 'PS',\n",
        "    'PlayStation 5': 'PS5',\n",
        "    'Xbox One': 'XOne',\n",
        "    'Xbox 360': 'X360',\n",
        "    'Xbox': 'XB',\n",
        "    'Nintendo DS': 'DS',\n",
        "    'Nintendo 3DS': '3DS',\n",
        "    'Super Nintendo': 'SNES',\n",
        "    'Nintendo 64': 'N64',\n",
        "    'Atari 2600': '2600',\n",
        "    'Mega Drive': 'GEN',\n",
        "    'Game Boy (avec Color)': 'GB',\n",
        "    'Game Boy Advance': 'GBA',\n",
        "    'Switch': 'Nintendo Switch' # On garde Nintendo Switch pour lier avec df_games (la Switch n'étant pas dans df_sales)\n",
        "}\n",
        "\n",
        "# On applique le dictionnaire à la colonne 'Console'\n",
        "df_consoles['Console'] = df_consoles['Console'].replace(dictionnaire_consoles)\n",
        "\n",
        "# On affiche les 5 premières lignes pour vérifier\n",
        "display(df_consoles.head())\n",
        "\n"
      ],
