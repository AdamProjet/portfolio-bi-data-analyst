        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Requirement already satisfied: pyxlsb in /usr/local/lib/python3.12/dist-packages (1.0.10)\n",
            "Voici les onglets cachés dans le fichier : ['Feuil1', 'vgsales']\n",
            "Fichiers chargés avec succès !\n"
          ]
        }
      ],
      "source": [
        "!pip install pyxlsb\n",
        "import pandas as pd\n",
        "\n",
        "# demande à Python de lister tous les onglets du fichier\n",
        "fichier = pd.ExcelFile('/content/VideoGame_Sales_1980-2016+(1).xlsb', engine='pyxlsb')\n",
        "print(\"Voici les onglets cachés dans le fichier :\", fichier.sheet_names)\n",
        "\n",
        "# 1. Charger les données\n",
        "df_games = pd.read_excel('/content/All_publish_VideoGame_2022.xlsb', engine='pyxlsb')\n",
        "# L'ajout magique de sheet_name=1 force Python à ignorer le TCD et à prendre la base de données !\n",
        "df_sales = pd.read_excel('/content/VideoGame_Sales_1980-2016+(1).xlsb', sheet_name=1, engine='pyxlsb')\n",
        "df_consoles = pd.read_excel('/content/Vente+de+console_2022.xlsx')\n",
        "\n",
        "print(\"Fichiers chargés avec succès !\")"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "\n",
        "# --- EXPLORATION DES DONNÉES ---\n",
        "\n",
        "print(\"=== Aperçu de df_games ===\")\n",
        "# 1. .head() : Affiche les 5 premières lignes (pour voir la tête des données)\n",
        "display(df_games.head())\n",
        "\n",
        "# 2. .info() : Donne le résumé technique (nombre de lignes, noms des colonnes, type de données et valeurs non nulles)\n",
        "print(\"\\n--- Infos sur df_games ---\")\n",
        "df_games.info()\n",
        "\n",
        "# 3. .isnull().sum() : Compte le nombre exact de valeurs manquantes (NaN) par colonne\n",
        "print(\"\\n--- Valeurs manquantes dans df_games ---\")\n",
        "display(df_games.isnull().sum())\n",
        "\n",
        "# 4. .describe() : Fait un résumé statistique rapide (moyenne, min, max) uniquement sur les colonnes numériques\n",
        "print(\"\\n--- Statistiques rapides de df_games ---\")\n",
        "display(df_games.describe())"
      ],
