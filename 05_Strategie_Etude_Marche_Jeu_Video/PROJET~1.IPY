    {
      "cell_type": "code",
      "source": [
        "# 3. LE DÉPIVOTAGE  (df_games)\n",
        "# Liste exacte decolonnes de plateformes\n",
        "colonnes_plateformes = ['PC', 'macOS', 'iOS', 'Web', 'Linux', 'Xbox One', 'Android', 'PS Vita',\n",
        "                        'PlayStation 4', 'Nintendo Switch', 'PlayStation 2', 'Wii U', 'PlayStation 3',\n",
        "                        'Xbox 36', 'GameCube', 'Wii', 'Xbox', 'Genesis', 'Neo Geo', 'Nintendo 3DS',\n",
        "                        'PlayStation', 'PSP', 'Nintendo DS', 'Game Boy Advance', 'Game Boy Color',\n",
        "                        'Game Boy', 'Nintendo DSi', 'SNES', 'SEGA Master System', 'Nintendo 64',\n",
        "                        'Classic Macintosh', 'Apple II', 'NES', 'Dreamcast', 'PlayStation 5',\n",
        "                        'Xbox Series S/X', 'Commodore / Amiga', 'Atari 26', 'Atari ST', 'Atari 78', 'SEGA Saturn']\n",
        "\n",
        "# On identifie les colonnes à garder intactes (le reste)\n",
        "colonnes_de_base = [col for col in df_games.columns if col not in colonnes_plateformes]\n",
        "\n",
        "import gc # Outil pour forcer le vidage de la RAM\n",
        "\n",
        "print(\"Dépivotage (Méthode Anti-Crash) en cours...\")\n",
        "\n",
        "# On crée une liste vide pour stocker nos petits morceaux (un morceau par console)\n",
        "liste_df_filtres = []\n",
        "\n",
        "for plat in colonnes_plateformes:\n",
        "    if plat in df_games.columns:\n",
        "        # On repère uniquement les jeux qui ont un \"1\" pour cette console\n",
        "        mask = df_games[plat] == 1\n",
        "\n",
        "        # Si la console possède au moins un jeu\n",
        "        if mask.any():\n",
        "            # On ne copie que les lignes utiles, ce qui sauve énormément de RAM !\n",
        "            df_temp = df_games.loc[mask, colonnes_de_base].copy()\n",
        "            df_temp['Plateforme'] = plat\n",
        "            liste_df_filtres.append(df_temp)\n",
        "\n",
        "# On assemble tous nos petits morceaux en un seul tableau final\n",
        "df_games_propre = pd.concat(liste_df_filtres, ignore_index=True)\n",
        "\n",
        "# VIDAGE DE LA RAM (Pour eviter bug chargement infini)\n",
        "# On supprime les gros objets qui ne servent plus à rien et on vide la poubelle\n",
        "del df_games\n",
        "del liste_df_filtres\n",
        "del df_temp\n",
        "gc.collect()\n",
        "\n",
        "print(\"Dépivotage terminé avec succès ! La RAM a survécu.\")"
      ],
      "metadata": {
        "id": "NxvxR3dalZMU",
        "colab": {
